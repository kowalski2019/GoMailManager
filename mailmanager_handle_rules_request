#!/bin/bash

# Check if all required arguments are provided
if [ $# -lt 7 ]; then
    echo "Usage: $0 rule_id user_email name condition condition_value action action_value description"
    exit 1
fi

rule_id="$1"
user_email="$2"
domain=`echo $user_email | awk -F@ '{print $2}'`
uname=`echo $user_email | awk -F@ '{print $1}'`
name="$3"
condition="$4"
condition_value="$5"
action="$6"
action_value="$7"
description="$8"

output_dir="/etc/dovecot/sieve"
mailhomedir="/home/vmail"
maildir="${mailhomedir}/${domain}"
user_maildir="${maildir}/${uname}"

echo "name: $name"
echo "user_email: $user_email"
echo "condition: $condition"
echo "condition_value: $condition_value"
echo "action: $action"
echo "action_value: $action_value"
echo "description: $description"
echo "deploy_mode: $deploy_mode"

# Declare an associative array
declare -A rule_data

rule_data["is_from"]="address :is \"from\""
rule_data["contains"]="body :text :contains :comparator \"i;ascii-casemap\""
rule_data["subject"]="header :contains :comparator \"i;ascii-casemap\" \"subject\""
rule_data["is_addressed_to"]="address :is \"to\""
rule_data["is_cc_to"]="address :is \"cc\""

rule_data["copy"]="fileinto :create \"$action_value\"; keep;"
rule_data["move"]="fileinto :create \"$action_value\";"
rule_data["forward"]="redirect \"$action_value\";"
rule_data["forward_and_keep"]="redirect :copy \"$action_value\";"
rule_data["delete"]="discard;"


echo "rule_data: ${rule_data[@]}"

echo -e "\n"

rule_nb=`ls -1 $output_dir | grep -E "${uname}-rule-[0-9]+-[0-9]+.sieve" | wc -l`
[ $rule_nb -lt 10 ] && rule_nb="0${rule_nb}"

output_file="${output_dir}/${uname}-rule-${rule_nb}-${rule_id}.sieve"

cat <<EOF > "$output_file"
require ["fileinto", "mailbox", "body", "copy"];

if ${rule_data[$condition]} "$condition_value"
{
   ${rule_data[$action]}
}

EOF

rule_line="include :global \"${uname}-rule-${rule_nb}-${rule_id}\";"

sieve_file="${user_maildir}/.dovecot.sieve"

# Add rule line if not present
grep -q "$rule_line" "$sieve_file" || echo "$rule_line" >> "$sieve_file"

echo "$(cat $output_file)"

